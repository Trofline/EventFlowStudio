<Window x:Class="EventFlowStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EventFlowStudio.ViewModels"
        Title="{Binding Strings.AppTitle}" 
        Height="850" Width="1300"
        Background="#0F172A" Foreground="#F8FAFC"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <vm:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="CardBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="InputBg" Color="#0F172A"/>
        <SolidColorBrush x:Key="PrimaryAccent" Color="#6366F1"/>
        <SolidColorBrush x:Key="SuccessAccent" Color="#10B981"/>

        <Style x:Key="HotkeyBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="GlobalHotkey">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TargetNameBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="GlobalHotkey">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryAccent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SEITENLEISTE -->
        <Border Grid.Column="0" Background="#0B1120" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="⚡ EventFlow" FontSize="24" FontWeight="Black" Foreground="{StaticResource PrimaryAccent}" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                <StackPanel Grid.Row="1">
                    <Button Content="{Binding Strings.TabProfiles}" Command="{Binding SwitchTabCommand}" CommandParameter="0" 
                            Background="{StaticResource CardBg}" Height="40" Margin="0,0,0,8" FontSize="13"/>
                    <Button Content="{Binding Strings.TabSettings}" Command="{Binding SwitchTabCommand}" CommandParameter="1" 
                            Background="{StaticResource CardBg}" Height="40" Margin="0,0,0,15" FontSize="13"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding Strings.LiveLogsHeader}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,5"/>
                    <TextBox Grid.Row="1" Text="{Binding LogOutput}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                             FontFamily="Consolas" Background="#020617" Foreground="#34D399" BorderThickness="0" TextWrapping="Wrap"/>
                </Grid>
            </Grid>
        </Border>

        <!-- HAUPTBEREICH -->
        <TabControl Grid.Column="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0" Padding="20">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- TAB 1: PROFILE -->
            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource CardBg}" CornerRadius="8" Padding="15,12" Margin="0,0,0,20"
                            Visibility="{Binding AppSettings.HideInstructions, Converter={StaticResource InvBoolToVis}}">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Strings.BannerTitle}" FontWeight="Bold" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Strings.BannerText}" Foreground="#94A3B8"/>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Profil Liste -->
                        <Border Grid.Column="0" Background="{StaticResource CardBg}" CornerRadius="8" Padding="12" Margin="0,0,15,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,4" Width="230">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsActive}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" Foreground="White"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Grid.Row="1" Content="{Binding Strings.NewProfileBtn}" Command="{Binding AddPresetCommand}" Margin="0,10,0,5"/>
                                <Grid Grid.Row="2" Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{Binding Strings.ImportBtn}" Command="{Binding ImportCommand}" Background="#334155" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Content="{Binding Strings.ExportBtn}" Command="{Binding ExportCommand}" Background="#334155" Margin="4,0,0,0"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Detail Editor -->
                        <Border Grid.Column="1" Background="{StaticResource CardBg}" CornerRadius="8" Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel DataContext="{Binding SelectedPreset}">

                                    <Grid Margin="0,0,0,20">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DataContext.Strings.ProfileEditorHeader, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="18" FontWeight="Black" Foreground="{StaticResource PrimaryAccent}"/>
                                            <TextBlock Text="{Binding DataContext.Strings.UnsavedText, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#EF4444" FontSize="14" FontWeight="Bold" Margin="10,2,0,0"
                                                       Visibility="{Binding DataContext.IsDirty, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="{Binding DataContext.Strings.TriggerBtn, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.TestRunCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="{StaticResource SuccessAccent}" Margin="0,0,10,0"/>
                                            <Button Content="{Binding DataContext.Strings.SaveBtn, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="16" FontWeight="Bold" Background="#0F172A" Padding="10" Margin="0,0,0,20"/>

                                    <!-- MEHRERE TRIGGER LISTE -->
                                    <TextBlock Text="{Binding DataContext.Strings.TriggersHeader, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,5"/>

                                    <ItemsControl ItemsSource="{Binding Triggers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0F172A" Margin="0,0,0,8" Padding="8" CornerRadius="6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="200"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <ComboBox ItemsSource="{Binding DataContext.TriggerTypes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Type}" Margin="0,0,8,0" Padding="6"/>

                                                        <TextBox Grid.Column="1" Text="{Binding TargetName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TargetNameBoxStyle}" ToolTip="Name (z.B. ac_client)"/>
                                                        <TextBox Grid.Column="1" Text="{Binding TargetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HotkeyBoxStyle}" ToolTip="Klicke rein und drücke Hotkey" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" KeyDown="HotkeyTextBox_KeyDown"/>

                                                        <Button Grid.Column="2" Content="❌" Background="Red" Margin="8,0,0,0" Command="{Binding DataContext.DeleteTriggerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="{Binding DataContext.Strings.AddTriggerBtn, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.AddTriggerCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="#334155" HorizontalAlignment="Left" Margin="0,0,0,20"/>

                                    <!-- AKTIONEN -->
                                    <TextBlock Text="{Binding DataContext.Strings.ActionsHeader, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,5"/>
                                    <ItemsControl ItemsSource="{Binding Actions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0F172A" CornerRadius="8" Padding="15" Margin="0,5">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="150"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                            <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.ActionTypes, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Type}" Margin="0,0,10,0" Padding="6"/>

                                                            <TextBox Grid.Column="2" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0"/>

                                                            <Button Grid.Column="3" Content="📁 ..." Margin="2,0" ToolTip="Datei suchen"
                                                                    Command="{Binding DataContext.BrowseFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" Background="#334155"/>

                                                            <Button Grid.Column="4" Content="❌" Background="Red" Margin="8,0,0,0" Command="{Binding DataContext.DeleteActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                        </Grid>

                                                        <StackPanel Orientation="Horizontal" Margin="30,10,0,0">
                                                            <CheckBox IsChecked="{Binding RunAsAdmin}" Content="{Binding DataContext.Strings.RunAsAdminCheckbox, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#F59E0B" FontWeight="Bold" Margin="0,0,15,0"/>
                                                            <CheckBox IsChecked="{Binding TerminateOnTriggerProcessExit}" Content="{Binding DataContext.Strings.TerminateCheckbox, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#CBD5E1" Margin="0,0,15,0"/>

                                                            <!-- NEU: Exit-Delay Eingabe -->
                                                            <TextBlock Text="{Binding DataContext.Strings.ExitDelayLabel, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <TextBox Text="{Binding ExitDelaySeconds}" Width="50"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="{Binding DataContext.Strings.AddActionBtn, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.AddActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="#334155" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: EINSTELLUNGEN -->
            <!-- TAB 2: EINSTELLUNGEN -->
            <TabItem>
                <Border Background="{StaticResource CardBg}" CornerRadius="8" Padding="30">
                    <StackPanel DataContext="{Binding AppSettings}">
                        <TextBlock Text="{Binding DataContext.Strings.SettingsHeader, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="22" FontWeight="Black" Foreground="White" Margin="0,0,0,30"/>

                        <TextBlock Text="{Binding DataContext.Strings.UiSettingsHeader, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryAccent}" Margin="0,0,0,10"/>
                        <CheckBox IsChecked="{Binding HideInstructions}" Content="{Binding DataContext.Strings.HideBannerCheckbox, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                            <TextBlock Text="{Binding DataContext.Strings.LanguageLabel, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding DataContext.AvailableLanguages, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Language}" Width="150" Padding="5"/>
                        </StackPanel>

                        <TextBlock Text="{Binding DataContext.Strings.SystemIntegrationHeader, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryAccent}" Margin="0,0,0,10"/>
                        <CheckBox IsChecked="{Binding EnableSystemTray}" Content="{Binding DataContext.Strings.SystemTrayCheckbox, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="14" Margin="0,0,0,10"/>

                        <!-- NEUE OPTIONEN: MINIMIERT STARTEN & FENSTER HOTKEY -->
                        <CheckBox IsChecked="{Binding StartMinimized}" Content="{Binding DataContext.Strings.StartMinimizedCheckbox, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="{Binding DataContext.Strings.ToggleHotkeyLabel, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Text="{Binding ToggleHotkeyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" Background="#1E293B" Foreground="#38BDF8" FontWeight="Bold" KeyDown="SettingsHotkey_KeyDown" ToolTip="Klicke rein und drücke Hotkey"/>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding AutoStartWindows}" Content="{Binding DataContext.Strings.AutoStartCheckbox, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
                        <CheckBox IsChecked="{Binding RunAsAdmin}" Content="{Binding DataContext.Strings.AlwaysAdminCheckbox, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="#F59E0B" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        <Button Content="{Binding DataContext.Strings.RestartAdminBtn, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.RestartAsAdminCommand, RelativeSource={RelativeSource AncestorType=Window}}" Background="#334155" HorizontalAlignment="Left" Margin="0,0,0,30"/>

                        <TextBlock Text="{Binding DataContext.Strings.UpdatesHeader, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryAccent}" Margin="0,0,0,10"/>
                        <CheckBox IsChecked="{Binding AutoUpdate}" Content="{Binding DataContext.Strings.AutoUpdateCheckbox, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontSize="14" Margin="0,0,0,10"/>
                        <Button Content="{Binding DataContext.Strings.SaveSettingsBtn, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}" Width="250" HorizontalAlignment="Left" Margin="0,20,0,0" Padding="15"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</Window>