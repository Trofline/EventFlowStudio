<Window x:Class="EventFlowStudio.ProcessPicker.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laufende App auswählen"
        Width="760" Height="620" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Farben kommen aus Themes/Theme.xaml -->
        <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource Surface2Color}"/>
        <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="Muted" Color="{StaticResource TextMutedColor}"/>
        <SolidColorBrush x:Key="Faint" Color="{StaticResource TextFaintColor}"/>
        <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>

        <Style x:Key="PickerButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface3Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="12,6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProcessItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="HeaderText" Text="Laufende App auswählen" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Wähle ein Programm aus. Name und Pfad werden automatisch übernommen." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Suche + Filter -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource Faint}"/>
                    <TextBox x:Name="SearchBox" Margin="34,0,8,0" Padding="0,9" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}" VerticalContentAlignment="Center"
                             Style="{x:Null}"
                             TextChanged="SearchBox_TextChanged"/>
                    <TextBlock Text="Name, Fenstertitel oder Pfad suchen…" Margin="36,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Faint}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Surface}" CornerRadius="8" Padding="3" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="AppsOnlyToggle" Style="{StaticResource FilterToggle}" Content="Apps" IsChecked="True" GroupName="Filter" Checked="Filter_Changed" ToolTip="Nur Programme mit sichtbarem Fenster"/>
                    <RadioButton x:Name="AllToggle" Style="{StaticResource FilterToggle}" Content="Alle Prozesse" GroupName="Filter" Checked="Filter_Changed" ToolTip="Auch Hintergrundprozesse anzeigen"/>
                </StackPanel>
            </Border>

            <Button Grid.Column="2" Style="{StaticResource PickerButton}" Content="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="14" FontWeight="Normal" Padding="12,6" Margin="10,0,0,0" ToolTip="Liste aktualisieren" Click="Refresh_Click"/>
        </Grid>

        <!-- Liste -->
        <Grid Grid.Row="2">
            <ListBox x:Name="ProcessList" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource ProcessItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                     SelectionChanged="ProcessList_SelectionChanged"
                     MouseDoubleClick="ProcessList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="32" Height="32" CornerRadius="6" Background="{StaticResource InputBrush}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Grid>
                                    <TextBlock Text="&#xE7AC;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Faint}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="8,0,10,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding FileName}" Foreground="{StaticResource Faint}" Margin="8,1,0,0" FontSize="12"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding PathText}" Foreground="{StaticResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding PathText}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding InstanceText}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding MemoryText}" Foreground="{StaticResource Faint}" HorizontalAlignment="Right" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="StatusText" Text="Lade laufende Prozesse…" Foreground="{StaticResource Muted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="400"/>
        </Grid>

        <!-- Fußzeile -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CountText" Foreground="{StaticResource Faint}" VerticalAlignment="Center" FontSize="12"/>
            <Button Grid.Column="1" Style="{StaticResource PickerButton}" Content="Abbrechen" IsCancel="True" Margin="0,0,10,0"/>
            <Button x:Name="SelectButton" Grid.Column="2" Style="{StaticResource PickerButton}" Background="{StaticResource Accent}" Content="Übernehmen" IsEnabled="False" Click="Select_Click"/>
        </Grid>
    </Grid>
</Window>
